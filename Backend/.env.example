# Emperor Smart Solutions Backend Environment Configuration Example
# Copy this file to .env and replace placeholders with production values

# Application Environment & Port
NODE_ENV=production
PORT=4000

# PostgreSQL Database Connection String
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/emperor_smart_solutions?schema=public"

# JWT Authentication Secret & Expiration
JWT_SECRET="your_production_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="1d"

# Bcrypt Salt Rounds for Password Hashing
BCRYPT_SALT_ROUNDS=10

# CORS Allowed Origins (Comma Separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://yourdomain.com"
